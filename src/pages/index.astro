---
// import translations
import translations from "@utils/t.ts";
import Layout from "@layouts/Layout.astro";
import Container from "@src/components/Container.astro";
import { Image } from 'astro:assets';
import frontimage from '../assets/images/front/edin-frontpage.jpg';
import newsEntries from '../data/news.json'
import LatestNewsCarousel from "@src/components/LatestNewsCarousel.astro";

const t = translations(Astro.url);

type NewsEntry = {
  date: string
  icon: string
  title: string
  description: string
  url?: string
}

const sortedNews: NewsEntry[] = [...newsEntries]
sortedNews.sort((a, b) => b.date.localeCompare(a.date))
const newsDateFormatter = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'long',
  timeZone: 'UTC',
})
---



<Layout>
	<Container class="pt-16 lg:grid grid-cols-3 gap-4">
		<div class="lg:col-span-2">
			<Image class="float-right w-5/12 m-3 rounded-md md:w-3/12 lg:hidden" src={frontimage} alt="Me at Meadows"/>
			<span set:html={t.home_description} />
		</div>
		<div class="lg:col-span-1">
			<Image class="hidden lg:block rounded-md" src={frontimage} alt="Me at Meadows"/>
		</div>
	</Container>

	<Container class="pt-10 md:grid md:grid-cols-2 lg:pt-1 lg:grid lg:grid-cols-2 gap-7">
		<div class="pb-5 lg:justify-items-center">
			<span set:html={t.interest}/>
		</div>
		<div class="lg:justify-items-center">
			<span set:html={t.education}/>
		</div>
	</Container>

<!-- News section -->
	<Container class="pt-5 lg:pt-1">
		<section aria-labelledby="news-heading">
			<div class="mb-5 flex items-center gap-3">
				<h2 id="news-heading" class="text-xl font-semibold tracking-wide text-stone-800 dark:text-stone-100" > Latest News </h2>
				<div class="h-px flex-1 bg-stone-300 dark:bg-stone-600" aria-hidden="true" ></div>
			</div>
		<LatestNewsCarousel headingId="latest-news-heading" />
		</section>
	</Container>	
	<Container class="pt-10 lg:pt-5">
		<blockquote class="saying">
			<p set:html={t.quote_description}/>
		</blockquote>
	</Container>
	<!-- <script type="text/javascript" id="clstr_globe" src="//clustrmaps.com/globe.js?d=06Km3jTn3k6LxdNaWxkPxDXBrLK2rrCbu1OpBBUj5mg&w=300"></script> -->
	<!-- <script type='text/javascript' id='clustrmaps' src='//cdn.clustrmaps.com/map_v2.js?cl=292524&w=400&t=tt&d=06Km3jTn3k6LxdNaWxkPxDXBrLK2rrCbu1OpBBUj5mg&co=fafaf9&ct=808080&cmo=3acc3a&cmn=ff5353'></script> -->
	 <!-- <script type="text/javascript" id="mapmyvisitors" src="//mapmyvisitors.com/map.js?cl=292524&w=400&t=tt&d=Bxi5o9EQpm5b5jwQWnv8myDUgDjsVLIqn7JBif80gro&co=fafaf9&ct=808080&cmo=3acc3a&cmn=ff5353"></script> -->
</Layout>

<style>
  .news-controls:not([hidden]) {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-block-end: 0.75rem;
  }

  .news-controls button {
    padding: 0.35rem 0.7rem;
    border: 1px solid currentColor;
    border-radius: 0.375rem;
    background: transparent;
    color: inherit;
    font: inherit;
  }

  .news-controls button[aria-disabled="true"] {
    opacity: 0.5;
  }

  .news-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .news-track {
    --news-gap: 1rem;
    display: flex;
    gap: var(--news-gap);
    margin: 0;
    padding: 0 0 0.5rem;
    list-style: none;
    overflow-x: auto;
    scroll-behavior: auto;
    scroll-snap-type: x mandatory;
  }

	.news-slide {
		flex: 0 0 100%;
		min-width: 0;
		scroll-snap-align: start;
	}

  @media (max-width: 640px) {
    .news-slide {
      flex-basis: 100%;
    }
  }
</style>

<script>
  function initLatestNews() {
    const section = document.querySelector('[data-latest-news]')
    if (!section || section.hasAttribute('data-news-ready')) return

    const track = section.querySelector<HTMLElement>('[data-news-track]')
    const controls = section.querySelector<HTMLElement>('[data-news-controls]')
    const previous = section.querySelector<HTMLButtonElement>('[data-news-prev]')
    const next = section.querySelector<HTMLButtonElement>('[data-news-next]')
    const firstSlide = track?.firstElementChild
    if (!track || !controls || !previous || !next || !firstSlide) return

    section.setAttribute('data-news-ready', '')

    const updateControls = () => {
      const maxScroll = track.scrollWidth - track.clientWidth
      controls.hidden = maxScroll <= 1
      previous.setAttribute('aria-disabled', String(track.scrollLeft <= 1))
      next.setAttribute('aria-disabled', String(track.scrollLeft >= maxScroll - 1))
    }

    const moveByCard = (direction: number) => {
      const button = direction < 0 ? previous : next
      if (button.getAttribute('aria-disabled') === 'true') return

      const gap = parseFloat(getComputedStyle(track).columnGap) || 0
      const step = firstSlide.getBoundingClientRect().width + gap
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      track.scrollBy({ left: direction * step, behavior: reduceMotion ? 'auto' : 'smooth' })
    }

    previous.addEventListener('click', () => moveByCard(-1))
    next.addEventListener('click', () => moveByCard(1))
    track.addEventListener('scroll', updateControls, { passive: true })
    const observer = new ResizeObserver(updateControls)
    observer.observe(track)
    updateControls()
  }

  initLatestNews()
  document.addEventListener('astro:page-load', initLatestNews)
</script>